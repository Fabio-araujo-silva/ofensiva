# Copie para .env e preencha. O .env nunca vai pro git.

# Chave da API da Anthropic para o Claudinho (opcional — sem ela ele usa frases prontas).
# Também dá pra colar a chave direto em Ajustes, dentro do app.
ANTHROPIC_API_KEY=

# Modelo usado pelo Claudinho
CLAUDE_MODELO=claude-opus-5-5

# Porta e endereço do servidor local
PORTA=4848
HOST=127.0.0.1

# Pasta onde ficam seus dados (relativa à raiz do projeto)
OFENSIVA_DADOS=dados
